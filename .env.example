# ---- JCMR environment ---------------------------------------------------
# Copy to .env.local for development. In production set these in the host's
# environment settings (Vercel → Project → Settings → Environment Variables).

# Database. Local: a file. Production: Turso (libsql://...) + auth token.
DATABASE_URL=file:./data/jcmr.db
DATABASE_AUTH_TOKEN=

# Signs the 30-day crew session cookie. Any long random string (32+ chars).
#   openssl rand -hex 32
SESSION_SECRET=

# The shared crew password, bcrypt-hashed. Make one with:
#   npm run hash-password -- 'the password'
CREW_PASSWORD_HASH=
# Development only (ignored in production): a plain password instead of a hash.
CREW_PASSWORD=

# The dark switch override. Leave unset so the admin switch in /crew/admin governs.
# PUBLIC_LIVE=true

# Protects the backup endpoint (/api/backup?key=...). Optional.
BACKUP_KEY=

# Google Street View for the crew "Ride the route" viewer (fills Mapillary's gaps,
# plus Look around). A browser key from the jcmr-ride Google Cloud project,
# restricted to this site and to the Maps Embed + Street View Static APIs.
GOOGLE_MAPS_KEY=
